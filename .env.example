# Auth
SECRET_KEY=any_long_random_string_here

# Facebook
FACEBOOK_APP_ID=test_fb_app_id
FACEBOOK_APP_SECRET=test_fb_app_secret
FACEBOOK_API_VERSION=v18.0

# LinkedIn
LINKEDIN_CLIENT_ID=test_li_client_id
LINKEDIN_CLIENT_SECRET=test_li_client_secret

# TikTok
TIKTOK_CLIENT_KEY=test_tt_client_key
TIKTOK_CLIENT_SECRET=test_tt_client_secret

# Mock mode (no real API calls)
MOCK_MODE=true

# URLs
BASE_URL=http://localhost:8000
LOGIN_REDIRECT_URL=http://localhost:3000/dashboard

# Database (use defaults or override)
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=social_platform

# RabbitMQ
RABBITMQ_USER=user
RABBITMQ_PASSWORD=password
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# MinIO
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadminpassword


DEV_MODE=true
