# Ignore Python virtual environment
venv/
.venv/
env/

# Ignore node modules and build outputs
**/node_modules/
**/.next/
**/dist/
**/build/

# Ignore git
.git/
.github/

# Ignore Python cache and bytecode
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
.pytest_cache/

# Ignore IDE and editor folders
.vscode/
.idea/
*.swp
*.swo

# Ignore OS-specific files
.DS_Store
Thumbs.db
